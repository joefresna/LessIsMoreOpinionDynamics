[experiment]
randomSeed=12345
outputTxtFile=../data/out.txt
cluster=false
numberOfExperiments=10
maxTime=10000
optionQualities=[1,0.8]
discoveryProbability=0.02
digestionTime=70

[network]
numberOfNodes=51
# possible netTypes are [ 'full' , 'erdos-renyi', 'barabasi-albert', 'rgg', 'rgg-fixed-degree' ]
netType=erdos-renyi
networkParameter=0.05

