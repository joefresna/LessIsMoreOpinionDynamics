[experiment]
randomSeed=1234
outputTxtFile=../data/out.txt
cluster=false
numberOfExperiments=100
maxTime=1000
optionQualities=[1,0.7]
discoveryProbability=0.05
digestionTime=50

[network]
numberOfNodes=31
# possible netTypes are [ 'full' , 'erdos-renyi', 'barabasi-albert', 'rgg', 'rgg-fixed-degree' ]
netType=rgg-fixed-degree
networkParameter=5

