[experiment]
randomSeed=912345
outputTxtFile=../data/out.txt
cluster=false
numberOfExperiments=1
maxTime=10000
optionQualities=[1,0.8]
discoveryProbability=0.01
deliberationTime=0

[network]
numberOfNodes=100
# possible netTypes are [ 'full' , 'erdos-renyi', 'barabasi-albert', 'rgg', 'rgg-fixed-degree' ]
netType=erdos-renyi
networkParameter=0.04
rewiringProbability=0.5