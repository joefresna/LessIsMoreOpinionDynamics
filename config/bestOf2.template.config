[experiment]
randomSeed=RND_SEED
outputTxtFile=OUT_FILE
cluster=true
numberOfExperiments=NUM_REP
maxTime=MAX_TIME
optionQualities=[1, QUALITY_LOW]
discoveryProbability=DISCOVERY_PROBABILITY
deliberationTime=DELIB_TIME

[network]
numberOfNodes=NET_SIZE
# possible netTypes are [ 'full' , 'erdos-renyi', 'barabasi-albert', 'rgg', 'rgg-fixed-degree' ]
netType=NET_TYPE
networkParameter=NET_PARAM
rewiringProbability=REWIRING_PROBABILITY

